{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/agent/**",
              "components/core/**",
              "components/forms/**",
              "components/layout/**",
              "ui_kits/console/**",
              "ui_kits/desktop/**",
              "ui_kits/website/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Inter|Noto Sans SC|Geist Mono))/i]",
        "message": "Font not provided by the design system. Available: Inter, Noto Sans SC, Geist Mono."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|dot|children|style|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: tone, dot, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:neutral|accent|success|danger|info)$/]",
        "message": "<Badge> tone must be one of 'neutral' | 'accent' | 'success' | 'danger' | 'info'."
      },
      {
        "selector": "JSXOpeningElement[name.name='BotAvatar'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|hue|size|status|ring|style|key|ref|className|style|children)$/]",
        "message": "<BotAvatar> doesn't accept that prop. Declared props: name, hue, size, status, ring, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='BotAvatar'] > JSXAttribute[name.name='hue'] > Literal[value!=/^(?:coral|tangerine|lime|mint|sky|violet|pink)$/]",
        "message": "<BotAvatar> hue must be one of 'coral' | 'tangerine' | 'lime' | 'mint' | 'sky' | 'violet' | 'pink'."
      },
      {
        "selector": "JSXOpeningElement[name.name='BotAvatar'] > JSXAttribute[name.name='status'] > Literal[value!=/^(?:working|online|blocked|offline)$/]",
        "message": "<BotAvatar> status must be one of 'working' | 'online' | 'blocked' | 'offline'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|icon|iconRight|loading|disabled|block|children|onClick|style|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, size, icon, iconRight, loading, disabled, block, children, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|accent|dark|secondary|ghost|danger|soft)$/]",
        "message": "<Button> variant must be one of 'primary' | 'accent' | 'dark' | 'secondary' | 'ghost' | 'danger' | 'soft'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Button> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|meta|actions|padding|interactive|onClick|children|style|key|ref|className|style|children)$/]",
        "message": "<Card> doesn't accept that prop. Declared props: title, meta, actions, padding, interactive, onClick, children, style."
