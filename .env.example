DATABASE_URL=postgres://baize:baize@localhost:5434/baize
PORT=3001
PUBLIC_BASE_URL=
# 兼容旧配置：未设置 GATEWAY_MODELS 时可用 GATEWAY_MODEL=baize-default
GATEWAY_MODELS=plan=baize-default,fast=baize-default
UPSTREAM_BASE_URL=https://api.openai.com/v1
UPSTREAM_API_KEY=
PRICE_INPUT_PER_M=0
PRICE_OUTPUT_PER_M=0

# pnpm dev --agent 从 shell 或下面的 .env 值读取，拼成一行 JSON 经 stdin 交给电脑代理。
# 这几项不会进入电脑代理环境；不要添加空的 AGENT_TOKEN 配置行。
# COMPUTER_ID：把 pnpm --filter @baize/control-plane seed 的输出填入 .env
# AGENT_TOKEN：把 pnpm --filter @baize/control-plane seed 的输出填入 .env
# CONTROL_PLANE_AGENT_URL：可选，默认 ws://127.0.0.1:3001/agent
# BAIZE_DATA_DIR：可选，默认使用 ~/.baize/bots
