DATABASE_URL=postgres://baize:baize@localhost:5434/baize
PORT=3001
PUBLIC_BASE_URL=
# 兼容旧配置：未设置 GATEWAY_MODELS 时可用 GATEWAY_MODEL=baize-default
GATEWAY_MODELS=plan=baize-default,fast=baize-default
UPSTREAM_BASE_URL=https://api.openai.com/v1
UPSTREAM_API_KEY=
PRICE_INPUT_PER_M=0
PRICE_OUTPUT_PER_M=0
# 设成 1 时会话 cookie 带 Secure，上了 HTTPS 再开。
COOKIE_SECURE=
# 工具凭据的加密钥匙，64 位十六进制，用 openssl rand -hex 32 生成，换了之前存的工具凭据就解不开。
# 不设时用代码里的开发密钥并告警；设了空值会启动失败，所以不用时整行保持注释。
# TOOL_SECRET_KEY=
# 账号令牌的加密钥匙，32 字节 base64，没有默认值，缺了控制面起不来。用 openssl rand -base64 32 生成，换了之前存的令牌就解不开。
CREDENTIALS_KEY=
# 发布走的平台接口根地址，默认官方地址。验证时指到假平台。
GITHUB_API_BASE_URL=https://api.github.com
X_API_BASE_URL=https://api.x.com
# 浏览器打开 Web 的地址。OAuth 回调是 <WEB_BASE_URL>/api/oauth/github/callback 和 .../x/callback，
# 要和平台后台登记的一字不差。留空就用 PUBLIC_BASE_URL；本地 pnpm dev 走 Vite 代理，填 http://localhost:5173。
WEB_BASE_URL=
# 账号页「连 GitHub」：GitHub App 的 client id 和 secret，要一起设。不设则连 GitHub 回 503。
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
# 账号页「连 X」：OAuth 2.0 应用的 client id。公共客户端只靠 PKCE，secret 留空；机密客户端才填 secret。
X_CLIENT_ID=
X_CLIENT_SECRET=
# 两家授权页的根地址，默认官方地址。GitHub 的令牌端点也在这下面，X 的令牌端点在 X_API_BASE_URL 下。验证时指到假平台。
GITHUB_OAUTH_BASE_URL=https://github.com
X_OAUTH_BASE_URL=https://x.com

# pnpm dev --agent 从 shell 或下面的 .env 值读取，拼成一行 JSON 经 stdin 交给电脑代理。
# 这几项不会进入电脑代理环境；不要添加空的 AGENT_TOKEN 配置行。
# COMPUTER_ID：把 pnpm --filter @baize/control-plane seed 的输出填入 .env
# AGENT_TOKEN：把 pnpm --filter @baize/control-plane seed 的输出填入 .env
# CONTROL_PLANE_AGENT_URL：可选，默认 ws://127.0.0.1:3001/agent
# BAIZE_DATA_DIR：可选，默认使用 ~/.baize/bots
